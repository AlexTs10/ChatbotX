{
  "extends": "@chatbotx.io/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strictNullChecks": true,
    "allowArbitraryExtensions": true,
    "noImplicitAny": false,
    "paths": {
      "@chatbotx.io/analytics-nextjs/provider/analytics-api-context": [
        "./src/shims/analytics-api-context.d.ts"
      ],
      "@/*": ["./src/*"],
      "@chatbotx.io/ui/*": ["../../packages/ui/src/*"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/dynamic": ["./src/shims/next-dynamic.tsx"],
      "next/script": ["./src/shims/next-script.tsx"],
      "next-intl": ["./src/shims/next-intl.ts"],
      "nuqs/adapters/next/app": [
        "./node_modules/nuqs/dist/adapters/tanstack-router.d.ts"
      ]
    }
  },
  "files": ["src/main.tsx", "vite.config.ts"]
}
